<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/visualOrderRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/visualOrderDragHandle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/visual_order_drag"
            android:padding="9dp"
            android:scaleType="center"
            android:src="@drawable/ic_drag_handle"
            android:tint="@color/avtohit_muted" />

        <TextView
            android:id="@+id/visualOrderNumber"
            android:layout_width="24dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:textColor="@color/avtohit_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/visualOrderTypeIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/visual_order_media_type"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/visualOrderMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/avtohit_muted"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/visualOrderDuplicate"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/visual_order_duplicate"
            android:padding="9dp"
            android:scaleType="center"
            android:src="@drawable/ic_duplicate"
            android:tint="@color/avtohit_positive" />

        <ImageButton
            android:id="@+id/visualOrderRemove"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/visual_order_remove"
            android:padding="9dp"
            android:scaleType="center"
            android:src="@drawable/ic_trash"
            android:tint="@color/avtohit_negative" />
    </LinearLayout>

    <TextView
        android:id="@+id/visualOrderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:breakStrategy="simple"
        android:ellipsize="none"
        android:includeFontPadding="false"
        android:textColor="@color/avtohit_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
