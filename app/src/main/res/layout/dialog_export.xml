<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/exportDialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_resolution_title"
            android:textColor="@color/avtohit_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/resolutionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/resolution720"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_resolution_720" />

            <RadioButton
                android:id="@+id/resolution1080"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_resolution_1080" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/export_direction_title"
            android:textColor="@color/avtohit_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/directionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <RadioButton
                android:id="@+id/directionVertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_direction_vertical"
                android:drawablePadding="10dp"
                android:text="@string/export_direction_vertical" />

            <RadioButton
                android:id="@+id/directionHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_direction_horizontal"
                android:drawablePadding="10dp"
                android:text="@string/export_direction_horizontal" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/export_fps_title"
            android:textColor="@color/avtohit_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/fpsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/fps30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_fps_30" />

            <RadioButton
                android:id="@+id/fps60"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_fps_60" />
        </RadioGroup>

        <TextView
            android:id="@+id/imageTimeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/image_time_title"
            android:textColor="@color/avtohit_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/imageTimeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/image_time_first_only"
            android:textColor="@color/avtohit_muted"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/imageTimeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="60"
            android:progress="0"
            android:progressTint="@color/avtohit_positive"
            android:thumbTint="@color/avtohit_positive" />

        <CheckBox
            android:id="@+id/autoSplitTimeCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/avtohit_positive"
            android:text="@string/auto_split_time"
            android:textColor="@color/avtohit_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/exportSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_chip_neutral"
            android:padding="12dp"
            android:textColor="@color/avtohit_text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
